{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Touchless",
  "version": "0.0.2",
  "identifier": "com.touchless.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Touchless",
        "width": 1200,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 800,
        "decorations": false,
        "center": true,
        "transparent": true
      },
      {
        "width": 320,
        "height": 180,
        "decorations": true,
        "alwaysOnTop": true,
        "transparent": true,
        "title": "Touchless",
        "skipTaskbar": true, 
        "x": 0,
        "y": 0,
        "visible": false,
        "label": "overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Team 3 - JS Club",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
